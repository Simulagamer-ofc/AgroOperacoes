<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Alertas da fazenda (Android 13+ pede autorização ao ligar os alertas) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Atualizar o app por dentro: no Android 12+, depois da 1ª vez, instala sem perguntar -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Baixar o APK novo sozinho só no Wi-Fi (rede não cobrada) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Edy: falar a pergunta pelo microfone (pedido só quando a pessoa toca no microfone) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 11+: deixa o app encontrar o serviço de reconhecimento de voz do aparelho -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="MercaPlant"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgroOperacoes">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Botão "Lembrar amanhã" das notificações de alerta -->
        <receiver
            android:name=".AlertaAcaoReceiver"
            android:exported="false" />
        <!-- Atualização do app: resultado da instalação e reabrir depois de atualizado -->
        <receiver
            android:name=".InstalacaoReceiver"
            android:exported="false" />
        <receiver
            android:name=".AtualizadoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Câmera: a foto é gravada num arquivo do cache do app e entregue à página -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
