<Project Sdk="Microsoft.NET.Sdk">
  <!-- MercaPlant Conecta: programa do computador da fazenda (Windows 10/11, .NET Framework 4.8 que já vem no Windows) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MercaPlantConecta</AssemblyName>
    <RootNamespace>MercaPlantConecta</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>MercaPlant Conecta</Product>
    <Company>MercaPlant</Company>
    <Description>Liga o certificado A3 (token ou cartão) e os equipamentos da fazenda ao MercaPlant</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
